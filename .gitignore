node_modules/
out/
out-e2e/
dist/
release/
.DS_Store
*.log
# ...EXCEPT the golden-window fixtures. They are COMMITTED so CI's `npm test` runs the full
# suite instead of skipping every fixture-backed test. They are real log excerpts scrubbed of
# third-party chat by the shared tests/fixture-scrub.mjs, which every tests/extract-*.mjs
# routes through — never hand-copy a raw log span in here. The blanket `*.log` above still
# hides the real game log, errors.log, and any dev/release log.
!tests/fixtures/*.log
.vite/
devlog.txt

# downloaded sound packs (audio binaries — `npm run fetch:packs` restores them; the app
# also self-provisions the default pack at runtime). peon/sc_marine are no longer shipped
# defaults but stay ignored so an existing dev's local copies never get committed.
resources/soundpacks/alan-rickman/
resources/soundpacks/peon/
resources/soundpacks/sc_marine/

# headless Electron e2e harness dumps DOM/screenshots here on a failed assertion
tests/e2e/artifacts/

# clean-machine sandbox harness writes results here; keep the folder, not the output
scripts/sandbox/results/*
!scripts/sandbox/results/.gitkeep
