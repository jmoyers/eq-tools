node_modules/
out/
out-e2e/
dist/
release/
.DS_Store
*.log
# ...EXCEPT the golden-window fixtures. They are COMMITTED so CI's `npm test` runs the full
# suite instead of skipping every fixture-backed test. They are real log excerpts scrubbed of
# third-party chat by the shared tests/fixture-scrub.mjs, which every tests/extract-*.mjs
# routes through — never hand-copy a raw log span in here. The blanket `*.log` above still
# hides the real game log, errors.log, and any dev/release log.
!tests/fixtures/*.log
.vite/
devlog.txt

# downloaded sound packs (audio binaries — `npm run fetch:packs` restores them; the app
# also self-provisions the default pack at runtime). peon/sc_marine are no longer shipped
# defaults but stay ignored so an existing dev's local copies never get committed.
resources/soundpacks/alan-rickman/
resources/soundpacks/peon/
resources/soundpacks/sc_marine/

# headless Electron e2e harness dumps DOM/screenshots here on a failed assertion
tests/e2e/artifacts/

# REPLAY BENCH (`npm run bench:replay`, docs/plans/chunked-replay.md §3). `.bench/replay.jsonl`
# is a LOCAL accumulating ledger — one line per run, on one machine, whose numbers mean nothing
# on another. `tests/bench/fixtures/` holds the standard bench input: ~100 MB of one person's
# real game log, which is exactly what the scrub law keeps out of a public repo. The PATH is
# the contract; the bytes stay local (the bench falls back to the machine's own log and says so).
.bench/
tests/bench/fixtures/

# MOB-SCRAPER wikitext cache (Task #63). The quests/spells caches ARE committed — they are ~900
# and ~2k small files and they make a re-scrape free for anyone. The mob corpus is 7,879 pages /
# ~40MB, which is an order of magnitude past that, and it is fully REGENERABLE (`npm run
# scrape:mobs` refills it from the wiki in ~15 minutes). The DATASET it produces —
# src/renderer/src/data/eqlegends/mobs.json — is committed, which is what reproducibility
# actually needs; the cache is only a re-run accelerator for whoever refreshes it next.
scripts/sources/cache/mobs/

# ITEM-SCRAPER response cache. Same reasoning as the mob cache above, one size up: 18,367
# pages fetched 50-at-a-time, so the cache is ~370 batch responses / ~30MB of raw wikitext,
# fully REGENERABLE (`npm run scrape:items` refills it in a couple of minutes because the
# fetch is batched). The DATASET it produces — src/main/data/items.json — is committed,
# which is what reproducibility actually needs.
scripts/sources/cache/items/

# clean-machine sandbox harness writes results here; keep the folder, not the output
scripts/sandbox/results/*
!scripts/sandbox/results/.gitkeep

# TERRAFORM (infra/). `.terraform/` is a provider cache (hundreds of MB, machine
# specific); `infra/dist/` is generated by `node infra/build.mjs`. STATE NEVER GOES
# IN GIT — it lives in the S3 backend, and a *.tfstate in a PUBLIC repo would
# publish every physical resource name (and, for some resources, secrets) forever.
# `.terraform.lock.hcl` is deliberately NOT ignored: the provider checksum lock is
# exactly the kind of thing that should be committed and reviewed.
infra/.terraform/
infra/dist/
*.tfstate
*.tfstate.*
*.tfplan
infra/tfplan
crash.log
crash.*.log
# Variable files carry the triage principal ARN, which contains the account id.
*.tfvars
*.auto.tfvars
!*.tfvars.example

# LOCAL FEEDBACK STACK working dir (`npm run dev:stack`, scripts/dev-feedback-server.mts):
# the reports.jsonl ledger and the log slices it accepted. Those slices are a real game log —
# they are exactly the artifact the scrub law and the 90-day S3 lifecycle exist for, so they
# never enter git. Delete the folder any time; the server recreates it.
.devstack/

# TRIAGE CLI working dir: the cached `terraform output -json` (physical names) and
# any log slice `triage-feedback show` downloads. Those slices are a user's own
# game log; they are read locally and never enter git or a public issue.
.triage/
