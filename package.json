{
  "name": "everquest-companion",
  "version": "0.1.0",
  "description": "EverQuest Legends companion — real-time log analysis and Plane of Sky quest tracking",
  "main": "./out/main/index.js",
  "author": "jmoyers",
  "private": true,
  "scripts": {
    "deps:electron": "node node_modules/electron/install.js",
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite dev",
    "scrape:posky": "tsx scripts/scrape-posky.ts",
    "scrape:bosses": "tsx scripts/scrape-bosses.ts",
    "scrape:quests": "tsx scripts/scrape-quests.ts",
    "scrape:spells": "tsx scripts/scrape-spells.ts",
    "fetch:packs": "tsx scripts/fetch-packs.mts",
    "gen:icon": "tsx scripts/gen-icon.mts",
    "gen:message-overlay": "tsx scripts/gen-message-overlay.ts",
    "test": "node --import tsx --test tests/*.test.mts",
    "test:e2e": "node --import tsx tests/e2e/combat-dashboard.e2e.mts",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^6.1.6",
    "@mui/material": "^6.1.6",
    "@mui/x-data-grid": "^7.22.2",
    "chokidar": "^4.0.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "cheerio": "^1.0.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "playwright-core": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
