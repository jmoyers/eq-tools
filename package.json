{
  "name": "everquest-companion",
  "version": "0.1.0",
  "description": "EverQuest Legends companion — real-time log analysis and Plane of Sky quest tracking",
  "main": "./out/main/index.js",
  "author": "jmoyers",
  "private": true,
  "scripts": {
    "deps:electron": "node node_modules/electron/install.js",
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite dev",
    "scrape:posky": "tsx scripts/scrape-posky.ts",
    "scrape:bosses": "tsx scripts/scrape-bosses.ts",
    "scrape:classes": "tsx scripts/scrape-classes.ts",
    "scrape:mobs": "tsx scripts/scrape-mobs.ts",
    "scrape:quests": "tsx scripts/scrape-quests.ts",
    "scrape:spells": "tsx scripts/scrape-spells.ts",
    "scrape:items": "tsx scripts/scrape-items.ts",
    "fetch:packs": "tsx scripts/fetch-packs.mts",
    "gen:icon": "tsx scripts/gen-icon.mts",
    "gen:message-overlay": "tsx scripts/gen-message-overlay.ts",
    "gen:telemetry-doc": "tsx scripts/gen-telemetry-doc.mts",
    "dev:stack": "tsx scripts/dev-feedback-server.mts",
    "fixtures:buffs": "node --import tsx tests/extract-fixtures.mjs",
    "fixtures:combat": "node --import tsx tests/extract-combat-fixtures.mjs",
    "fixtures:combo": "node --import tsx tests/extract-combo-fixtures.mjs",
    "fixtures:consider": "node --import tsx tests/extract-consider-fixtures.mjs",
    "fixtures:item-tiers": "node --import tsx tests/extract-item-tier-fixtures.mjs",
    "fixtures:leveling": "node --import tsx tests/extract-leveling-fixtures.mjs",
    "fixtures:loot": "node --import tsx tests/extract-loot-fixtures.mjs",
    "fixtures:procs": "node --import tsx tests/extract-proc-fixtures.mjs",
    "fixtures:progression": "node --import tsx tests/extract-progression-fixtures.mjs",
    "fixtures:session": "node --import tsx tests/extract-session-fixtures.mjs",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/",
    "lint:measure": "tsx scripts/lint-report.mts --measure",
    "lint:ratchet": "tsx scripts/lint-report.mts --ratchet",
    "test": "node --import tsx --test tests/*.test.mts",
    "test:e2e": "node --import tsx tests/e2e/run-all.mts",
    "bench:replay": "node --import tsx tests/bench/replay.bench.mts",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^6.1.6",
    "@mui/material": "^6.1.6",
    "@mui/x-data-grid": "^7.22.2",
    "chokidar": "^4.0.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "onnxruntime-node": "1.20.1",
    "phonemizer": "1.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1102.0",
    "@aws-sdk/credential-providers": "^3.1102.0",
    "@aws-sdk/dsql-signer": "^3.1102.0",
    "@aws-sdk/s3-presigned-post": "^3.1102.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.20.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "cheerio": "^1.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.7",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "pg": "^8.22.0",
    "playwright-core": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6"
  },
  "overrides": {
    "builder-util-runtime": "^9.7.0",
    "tar": "^7.5.22",
    "vite": {
      "esbuild": "$esbuild"
    },
    "electron-vite": {
      "esbuild": "$esbuild"
    }
  }
}
